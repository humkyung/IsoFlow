{
  "_comment": "ISOGEN SKEY → 2D 심볼 형상 매핑. 형상 정의는 symbols-2d.json, 규약은 docs/symbol-set.md 참조",
  "version": "1.0",
  "source": "ISOGEN Symbol Keys (Alias Ltd.) 의 SKEY 코드 체계 + wermac 계열 등각도 심볼 관례",

  "endTypes": {
    "_comment": "SKEY 의 '**' 자리에 치환되는 접합 방식 코드. symbols-2d.json 의 endTreatments 와 1:1 대응",
    "BW": "Butt Weld — 맞대기 용접",
    "SW": "Socket Weld — 소켓 용접",
    "SC": "Screwed — 나사",
    "FL": "Flanged — 플랜지",
    "PL": "Plain End — 평단면",
    "CP": "Compression — 압축",
    "GL": "Glued — 접착",
    "PF": "Push Fit — 밀어끼움",
    "FA": "Flared — 플레어",
    "CL": "Clamped — 클램프",
    "BS": "Ball / Socket — 볼&소켓 (SB 로도 표기)",
    "LN": "Liner / Nut — 라이너/너트",
    "LC": "Liner / Clamp — 라이너/클램프",
    "LR": "Reducing Liner / Nut — 리듀싱 라이너/너트",
    "MP": "Male Part — 수형 접속부"
  },

  "expansionRule": {
    "_comment": "SKEY 확장 규칙 — PcfParser / SkeyTable 이 따르는 순서",
    "steps": [
      "1. SKEY 가 endTypes 의 코드로 끝나면 그 2자를 endType 으로 분리하고 앞 2자를 base 로 본다.",
      "2. 정확히 일치하는 skeys 항목이 있으면 그것을 우선 사용한다 (예: FLWN, WTBW).",
      "3. 없으면 base + '**' 패턴으로 조회한다 (예: ELBW → EL** + BW).",
      "4. 그래도 없으면 PCF 컴포넌트 타입으로 폴백한다 (fallbackByPcfType).",
      "5. 최종 실패 시 UNKNOWN 처리하고 진단 리포트에 남긴다 — 조용히 버리지 않는다."
    ]
  },

  "procedural": {
    "_comment": "고정 심볼이 아니라 실제 좌표에서 절차적으로 작도하는 컴포넌트. 심볼은 엔드 트리트먼트 마크만 붙는다.",
    "PIPE": { "draw": "END-POINT 두 점을 잇는 직선" },
    "ELBOW": { "draw": "END-POINT 2 + CENTRE-POINT + ANGLE 로 꺾임 작도", "skeyPatterns": ["EL**", "ER**", "EB**", "EU**"] },
    "BEND": { "draw": "ELBOW 와 동일하되 반경 표기 옵션", "skeyPatterns": ["BE**", "BM**", "MI**", "PB**", "BU**"] },
    "TEE": { "draw": "END-POINT 2 + CENTRE-POINT + BRANCH1-POINT 로 분기 작도", "skeyPatterns": ["TE**", "TS**", "TT**", "TY**"] },
    "CROSS": { "draw": "END-POINT 2 + BRANCH1/2-POINT 로 십자 작도", "skeyPatterns": ["CR**", "CY**", "CS**"] },
    "ELBOW-TEED": { "draw": "엘보 + 분기", "skeyPatterns": ["ET**", "BT**", "MT**", "TB**"] }
  },

